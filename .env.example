# ── Database ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=6432
DB_NAME=iems
DB_USER=tag
DB_PASSWORD=change-me
DB_POOL_MAX=5

# ── Aplikasi ─────────────────────────────────────────────
PORT=3001
NODE_ENV=development
TIMEZONE=Asia/Makassar
TZ=Asia/Makassar
PLANT_CODE=5051
CORS_ORIGIN=*

# ── SAP Inbound ──────────────────────────────────────────
SAP_INBOUND_URL=https://sap.example.internal/endpoint
SAP_INBOUND_USERNAME=sap-user
SAP_INBOUND_PASSWORD=change-me
TGT_TABLE=ph3_order
ID_TIMESHEET=

# ── Worker SAP Staging ───────────────────────────────────
SAP_STAGE_INTERVAL=900
SAP_POST_INTERVAL=1800
SAP_POST_LIMIT=500
SAP_POST_WORKERS=5
SAP_OPS_INTERVAL=10
# SAP_STAGING_DB_HOST=
# SAP_STAGING_DB_PORT=
# SAP_STAGING_DB_NAME=
# SAP_STAGING_DB_USER=
# SAP_STAGING_DB_PASSWORD=

# ── Kafka messaging (optional, docker compose --profile kafka) ─────────────
# direct = sap-post-worker posts to SAP; kafka = posting goes through Kafka
SAP_TRANSPORT=direct
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# KAFKA_DEFAULT_PARTITIONS=6
# KAFKA_REPLICATION_FACTOR=1
# SAP_KAFKA_RELAY_INTERVAL=60
# SAP_KAFKA_REQUEUE_AFTER_MINUTES=360
# SAP order source, only where sap-orders-producer runs (--profile kafka-source)
# SRC_HOST=
# SRC_PORT=5432
# SRC_DATABASE=
# SRC_USER=
# SRC_PASSWORD=
# SRC_TABLE=public.ph3_order
# SAP_ORDER_PLANTS=5051,5071

# ── SQL Server (ETL machine hours) ───────────────────────
SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_DATABASE=

# ── Device Heartbeat (Uptime Tablet KPI) ─────────
# Shared LAN token: the API rejects heartbeats without it, and the web build embeds it so
# enrolled kiosk tablets can send them. It filters stray traffic; it is not a user credential.
# Enroll a tablet once by opening the app with ?kiosk=<name>, e.g. /login-timesheet?kiosk=TAB-WC01
# DEVICE_HEARTBEAT_TOKEN=
# Tablets that have not sent a heartbeat for this many days drop out of the fleet.
# EWS_TABLET_ACTIVE_DAYS=7
