# Runtime data and every credential stay outside the repository.
IEMS_AUTOMATION_LAB_ROOT=D:/IEMS-Automation-Lab/n8n-corrective-acceptance-20261027
# lab-runtime.mjs creates config.json with private generated values on first start.
# External/split process runs must provision these values themselves:
IEMS_AUTOMATION_SMTP_PORT=2527
IEMS_AUTOMATION_SINK_URL=http://127.0.0.1:8027
IEMS_AUTOMATION_SINK_TOKEN=SET_OUTSIDE_GIT
IEMS_AUTOMATION_SINK_FILE=D:/IEMS-Automation-Lab/n8n-corrective-acceptance-20261027/sink-receipts.jsonl
IEMS_AUTOMATION_N8N_URL=http://127.0.0.1:5687
IEMS_AUTOMATION_WEBHOOK_TOKEN=SET_OUTSIDE_GIT
# Human-admin provisioned, plant-scoped automation credential; renew/revoke through IEMS before expiry.
# Bind the same value in n8n's private Authorization credential. Never use an owner cookie.
IEMS_AUTOMATION_SERVICE_TOKEN=SET_OUTSIDE_GIT
IEMS_AUTOMATION_SLA_MINUTES=0.08333333333333333
