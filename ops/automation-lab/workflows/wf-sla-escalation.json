{
  "id": "wf-sla-escalation",
  "name": "IEMS - Unassigned ticket SLA escalation",
  "active": false,
  "nodes": [
    {
      "id": "operator-trigger",
      "name": "Operator trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        160,
        100
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "iems-sla-escalation",
        "authentication": "headerAuth",
        "responseMode": "lastNode",
        "options": {}
      },
      "webhookId": "iems-sla-escalation",
      "credentials": {
        "httpHeaderAuth": {
          "id": "iems-webhook-auth",
          "name": "IEMS private webhook"
        }
      }
    },
    {
      "id": "sla-schedule",
      "name": "SLA schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        160,
        380
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "read-due-tickets",
      "name": "Read due tickets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        240
      ],
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:4319/api/cs/automation/sla-breaches?limit=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-IEMS-Execution-Id",
              "value": "={{ $execution.id }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "iems-service-api",
          "name": "IEMS scoped automation service"
        }
      }
    },
    {
      "id": "due-tickets-exist",
      "name": "Due tickets exist",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        560,
        240
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-due-tickets",
              "leftValue": "={{ $json.data.items.length > 0 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "one-item-per-record",
      "name": "One item per record",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        720,
        240
      ],
      "parameters": {
        "fieldToSplitOut": "data.items",
        "options": {}
      }
    },
    {
      "id": "escalate-eligible-ticket",
      "name": "Escalate eligible ticket",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        240
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:4319/api/cs/automation/escalate",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-IEMS-Execution-Id",
              "value": "={{ $execution.id }}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{ $json.occurrenceKey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { ticketId: $json.ticketId, expectedVersion: $json.expectedVersion, reason: \"Unassigned ticket exceeded its configured SLA\" } }}",
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "iems-service-api",
          "name": "IEMS scoped automation service"
        }
      }
    },
    {
      "id": "execution-reference",
      "name": "Execution reference",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1140,
        240
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ { n8nExecutionId: $execution.id, result: $json.data || $json } }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Operator trigger": {
      "main": [
        [
          {
            "node": "Read due tickets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "SLA schedule": {
      "main": [
        [
          {
            "node": "Read due tickets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read due tickets": {
      "main": [
        [
          {
            "node": "Due tickets exist",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One item per record": {
      "main": [
        [
          {
            "node": "Escalate eligible ticket",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Escalate eligible ticket": {
      "main": [
        [
          {
            "node": "Execution reference",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Due tickets exist": {
      "main": [
        [
          {
            "node": "One item per record",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Execution reference",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Bangkok",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "errorWorkflow": "wf-automation-error"
  },
  "pinData": {},
  "tags": [],
  "versionId": "e65d652d-0484-4f2d-a134-6b13bc9bb029"
}
