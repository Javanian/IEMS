{
  "name": "WhatsApp Approval & Hand-off Sync",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-handoff",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook-trigger",
      "name": "Webhook Inbound Signal",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "webhookId": "whatsapp-handoff"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst convId = body.conversationId;\nconst ticketId = body.ticketId;\nconst note = body.operatorNote || 'Operator handoff initiated';\nconst idempotencyKey = body.idempotencyKey || ('n8n-wh-' + convId + '-' + Date.now());\n\nreturn {\n  conversationId: convId,\n  ticketId: ticketId,\n  operatorNote: note,\n  idempotencyKey: idempotencyKey\n};"
      },
      "id": "node-prepare-payload",
      "name": "Prepare Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:4313/api/cs/automation/whatsapp-handoff",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ $json.idempotencyKey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"conversationId\": \"{{ $json.conversationId }}\",\n  \"ticketId\": \"{{ $json.ticketId }}\",\n  \"operatorNote\": \"{{ $json.operatorNote }}\"\n}",
        "options": {}
      },
      "id": "node-execute-handoff-sync",
      "name": "Execute Handoff Sync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"{{ $json.data.whatsappState }}\",\n  \"conversationId\": \"{{ $json.data.conversationId }}\",\n  \"deliveryId\": \"{{ $json.data.deliveryId }}\",\n  \"handoffSynced\": true,\n  \"disclaimer\": \"{{ $json.data.disclaimer }}\"\n}",
        "options": {}
      },
      "id": "node-respond-webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [860, 300]
    }
  ],
  "connections": {
    "Webhook Inbound Signal": {
      "main": [
        [
          {
            "node": "Prepare Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Payload": {
      "main": [
        [
          {
            "node": "Execute Handoff Sync",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute Handoff Sync": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
