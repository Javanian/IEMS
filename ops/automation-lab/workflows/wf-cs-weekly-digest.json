{
  "id": "wf-cs-weekly-digest",
  "name": "IEMS - Weekly customer service digest",
  "active": false,
  "nodes": [
    {
      "id": "operator-trigger",
      "name": "Operator trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        160,
        100
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "iems-cs-weekly-digest",
        "authentication": "headerAuth",
        "responseMode": "lastNode",
        "options": {}
      },
      "webhookId": "iems-cs-weekly-digest",
      "credentials": {
        "httpHeaderAuth": {
          "id": "iems-webhook-auth",
          "name": "IEMS private webhook"
        }
      }
    },
    {
      "id": "weekly-monday-08-00-bangkok",
      "name": "Weekly Monday 08:00 Bangkok",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        160,
        380
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 8,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "create-and-dispatch-authoritative-digest",
      "name": "Create and dispatch authoritative digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        240
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:4319/api/cs/automation/digest/dispatch",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-IEMS-Execution-Id",
              "value": "={{ $execution.id }}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{ \"digest:\" + ($json.body ? \"DEMO:\" + ($json.body.periodKey || \"missing-period-key\") : \"WEEKLY:\" + $now.toUTC().startOf(\"week\").toFormat(\"yyyy-MM-dd\")) }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { mode: $json.body ? \"DEMO\" : \"WEEKLY\", ...($json.body?.periodKey ? { periodKey: $json.body.periodKey } : {}) } }}",
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "iems-service-api",
          "name": "IEMS scoped automation service"
        }
      }
    },
    {
      "id": "execution-reference",
      "name": "Execution reference",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        740,
        240
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ { n8nExecutionId: $execution.id, result: $json.data || $json } }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Operator trigger": {
      "main": [
        [
          {
            "node": "Create and dispatch authoritative digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Weekly Monday 08:00 Bangkok": {
      "main": [
        [
          {
            "node": "Create and dispatch authoritative digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create and dispatch authoritative digest": {
      "main": [
        [
          {
            "node": "Execution reference",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Bangkok",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "errorWorkflow": "wf-automation-error"
  },
  "pinData": {},
  "tags": [],
  "versionId": "2a7911f2-f945-43de-a611-5814da6684c5"
}
