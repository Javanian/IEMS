{
  "name": "Weekly CS Operations Digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [1],
              "triggerAtHour": 8,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "node-weekly-cron",
      "name": "Weekly Cron Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "url": "http://127.0.0.1:4313/api/cs/automation/digest?days=7",
        "options": {}
      },
      "id": "node-fetch-digest",
      "name": "Fetch Operations Digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "fromEmail": "automation-reports@iems.local",
        "toEmail": "reports@iems.local",
        "subject": "=Weekly CS Operations Digest - {{ $now.toFormat('yyyy-MM-dd') }}",
        "html": "={{ $json.data.html }}",
        "options": {
          "allowUnauthorizedCerts": true,
          "port": 1025
        }
      },
      "id": "node-send-digest-email",
      "name": "Send Email via Local SMTP Sink",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [640, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:4313/api/cs/automation/digest/record",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "=digest-rec-{{ $now.toFormat('yyyy-MM-dd') }}-{{ $json.data.summary.periodDays }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"summary\": {{ JSON.stringify($json.data.summary) }},\n  \"recipientEmail\": \"reports@iems.local\",\n  \"subject\": \"Weekly CS Operations Digest\"\n}",
        "options": {}
      },
      "id": "node-record-digest-receipt",
      "name": "Record Digest Receipt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [860, 300]
    }
  ],
  "connections": {
    "Weekly Cron Trigger": {
      "main": [
        [
          {
            "node": "Fetch Operations Digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Operations Digest": {
      "main": [
        [
          {
            "node": "Send Email via Local SMTP Sink",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Email via Local SMTP Sink": {
      "main": [
        [
          {
            "node": "Record Digest Receipt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
