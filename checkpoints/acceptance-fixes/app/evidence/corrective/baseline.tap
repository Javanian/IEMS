er" min="1" step="1" required />\n      <WorkspaceField label="Previous shortage revision (0 for first refresh)" name="expectedShortageRevision" type="number" min="0" step="1" defaultValue="0" required />\n      <WorkspaceField label="Refresh reason" name="reason" minLength={3} maxLength={500} required />\n    </InquiryCommand>\n    {refreshed && !sources.length && <p role="status">No purchased material shortages were produced for this approved demand. Company output materials use manufacturing supply planning.</p>}\n    <form className="pf-form" onSubmit={event => { event.preventDefault(); setSourceId(new FormData(event.currentTarget).get(\'sourceId\')); }}><WorkspaceField label="Existing shortage source ID" name="sourceId" required /><button>Open shortage</button></form>\n    {[...new Set([...sources, ...(sourceId ? [sourceId] : [])])].map(id => <ShortageSource key={id} sourceId={id} />)}\n  </section>;\n}\nexport function ProcurementList({ kind }) {\n  const location = useLocation(), navigate = useNavigate();\n  const cursor = new URLSearchParams(location.search).get(\'cursor\');\n  const resource = useResource(`/api/procurement/${kind}${cursor ? `?cursor=${encodeURIComponent(cursor)}` : \'\'}`);\n  const [error, setError] = useState(null), [busy, setBusy] = useState(false);\n  const lock = useRef(false);\n  const title = { vendors: \'Vendors\', requests: \'Purchase requests\', orders: \'Purchase orders\' }[kind];\n  return <><h1>{title}</h1>{kind === \'requests\' && <ShortageProcurement />}<nav className="pf-actions" aria-label="Procurement"><Link to={`${base}/vendors`}>Vendors</Link><Link to={`${base}/requests`}>Purchase requests</Link><Link to={`${base}/orders`}>Purchase orders</Link></nav><p>Owned procurement documents. Issue is local only; no purchasing dispatch, stock receipt or payment occurs here.</p>{kind === \'requests\' && <Link to={`${base}/requests/new`}>Create purchase request</Link>}<section className="pf-panel"><Resource resource={resource}>{({ data, page }) => <>{!data.length ? <p>No {title.toLowerCase()} in this plant yet. {kind === \'vendors\' ? \'Create a vendor below.\' : kind === \'requests\' ? \'Create a request for an existing vendor.\' : \'Approve and convert a purchase request first.\'}</p> : <ul className="pf-list">{data.map(row => <li key={row._id}><Link to={`${base}/${kind}/${row._id}`}>{row.name || displayReference(kind === "orders" ? "purchaseOrder" : "request",row)}</Link>{row.status && <span>{operatorStatus(row.status)}</span>}</li>)}</ul>}<div className="pf-actions">{cursor && <Link to={`${base}/${kind}`}>First page</Link>}{page.nextCursor && <Link to={`?cursor=${page.nextCursor}`}>Next page</Link>}</div></>}</Resource></section>{kind===\'vendors\'&&<MutationForm keyed commandSlot="procurement:vendor:new" title="Create vendor" submitLabel="Create vendor" save={(body,send)=>send(\'/api/procurement/vendors\',{body})} onSaved={data=>navigate(`${base}/vendors/${data._id}`)}><Input label="Vendor name" name="name" required maxLength={200}/></MutationForm>}</>;\n}\nexport function NewPurchaseRequest() {\n  const navigate = useNavigate(), [count, setCount] = useState(1), [busy, setBusy] = useState(false), [error, setError] = useState(null);\n  const lock = useRef(false);\n  return <><h1>Create purchase request</h1><Link to={`${base}/vendors`}>Find vendor ID</Link><MutationForm keyed commandSlot="procurement:request:new" title="Purchase request" submitLabel="Save purchase request" save={(values,send)=>send(\'/api/procurement/requests\',{body:procurementContent(values,count)})} onSaved={data=>navigate(`${base}/requests/${data._id}`)}><Input label="Vendor ID" name="vendorId" required /><p>Use exact decimal strings and one currency. Server applies NO_TAX and LINE_HALF_UP; no FX or UOM conversion.</p>{Array.from({ length: count }, (_, i) => <fieldset key={i}><legend>Line {i + 1}</legend><div className="pf-fields"><Input label="Description" name={`description${i}`} required maxLength={200} /><Input label="Quantity (exact decimal)" name={`quantity${i}`} inputMode="decimal" required /><Input label="UOM" name={`uom${i}`} pattern="[A-Z][A-Z0-9_]{0,15}" required /'... 17164 more characters,
    expected: /<DocumentIssue[^>]*kind="purchaseOrder"/,
    operator: 'match',
    diff: 'simple'
  }
