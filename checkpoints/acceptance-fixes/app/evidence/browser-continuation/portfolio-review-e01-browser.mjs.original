tedDelivery);}else await form.clickIn(root,'Confirm delivery');await ready('document.querySelector("#shipment-delivery")?.innerText.includes("Still to confirm: 0")');deliveries[index]=await api(`/deliveries/shipments/${shipments[index]._id}`);assert.equal(deliveries[index].status,'DELIVERED');assert.equal(deliveries[index].confirmationCount,1);assert.equal(deliveries[index].confirmations[0].receiverName,pod.receiver_name);assert.equal(deliveries[index].confirmations[0].receiverReference,pod.receiver_badge);assert.equal(deliveries[index].confirmations[0].evidenceReference,pod.pod_id);assert.equal(iso(deliveries[index].confirmations[0].deliveredAt),iso(pod.delivered_at));assert.deepEqual(deliveries[index].deliveredSerials,[...fixtureShipment.lines[0].serials].sort());assert.equal((await api(`/fulfillment/shipments/${shipments[index]._id}`)).status,'SHIPPED');native(`${pod.pod_id} actual original receiver/reference/serial POD${index===0?' with committed response-loss exact retry':''}`);await capture(`pod-${index+1}`,'#shipment-delivery');});
  }
  for(const [index,invoice] of f.invoices.entries())schedule(invoice.issued_date,invoice.id,async()=>{const root=formScope('Issue invoice');await navigate(`fulfillment/orders/${so._id}`,`document.querySelector(${js(root)})?.querySelector('option[value="${shipments[index]._id}"]')`);await form.fillIn(root,'shipmentId',shipments[index]._id);await form.fillIn(root,'invoiceQuantity',invoice.lines[0].billed_qty);await form.clickIn(root,'Issue invoice');await ready(`document.querySelector('tbody tr td:last-child')?.textContent===${js(`${index===0?'6':'10'} UN`)}`);invoices[index]=await findActual('fulfillmentInvoices',{salesOrderId:so._id,'lines.shipmentId':shipments[index]._id},'/fulfillment/invoices');assert.ok(invoices[index]);assert.equal(invoices[index].netAmount,invoice.totals.net_amount);assert.equal(invoices[index].taxAmount,invoice.totals.tax_amount);assert.equal(invoices[index].total,invoice.totals.gross_amount);manifest.references[invoice.id]=invoices[index]._id;native(`${invoice.id} exact original shipment billing/net/VAT/gross`);});
  for(const [index,payment] of f.payments.entries())schedule(payment.received_at,payment.id,async()=>{const root=formScope('Allocate payment');await navigate(`fulfillment/invoices/${invoices[index]._id}`,`document.querySelector(${js(root)})?.querySelector('[name=amount]')`);await form.fillIn(root,'amount',payment.amount_received);await form.fillIn(root,'reference',payment.payment_reference);await form.clickIn(root,'Allocate payment');await ready(`!document.querySelector(${js(root)})`);const paid=await api(`/fulfillment/invoices/${invoices[index]._id}`);assert.equal(paid.status,'PAID');assert.equal(paid.outstandingAmount,'0.00');payments[index]=await findActual('fulfillmentPayments',{reference:payment.payment_reference,accountId},'/fulfillment/payments');assert.ok(payments[index]);manifest.references[payment.id]=payments[index]._id;native(`${payment.id} original exact payment and invoice settlement`);if(index===1)await capture('settled-invoice');});
  try{for(const event of events.sort((a,b)=>new Date(a.date)-new Date(b.date))){at(event.date);await event.action();}}finally{for(const context of contexts)await context.close();}
  const woIds=workOrders.map(row=>row._id),outputs=await db.collection('manufacturingOutputUnits').find({workOrderId:{$in:woIds}}).toArray(),labor=await db.collection('manufacturingLabor').find({workOrderId:{$in:woIds}}).toArray(),consumptions=await db.collection('manufacturingMovements').find({workOrderId:{$in:woIds},kind:'MATERIAL_CONSUMED'}).toArray();assert.equal(outputs.length,10);assert.equal(new Set(outputs.map(row=>row.serial)).size,10);assert.ok(outputs.every(row=>row.status==='SHIPPED'));assert.deepEqual(outputs.map(row=>row.serial).sort(),f.work_orders.flatMap(row=>row.produced_serials).sort());assert.equal(labor.length,4);assert.equal(consumptions.length,10);for(const [index,wo] of workOrders.entries())for(const [materialIndex,receipt] of receipts.entries()){const movement=consumptions.find(row=>row.workOrderId===wo._id&&row.receiptId===receipt._id);assert.ok(movement);assert.equal(units(movement.quantity),units(f.work_orders[index].material_requirements[materialIndex].issued_qty));assert.equal(movement.uom,f.engineering_package.bom.components[materialIndex].uom);assert.equal(movement.materialTrace.lotNumber,f.procurement.goods_receipt.lines[materialIndex].lot_number);assert.equal(movement.materialTrace.heatNumber,f.procurement.goods_receipt.lines[materialIndex].heat_number);}assert.equal(invoices.reduce((sum,row)=>sum+BigInt(row.total.replace('.','')),0n),13597500n);assert.equal(payments.reduce((sum,row)=>sum+BigInt(row.amount.replace('.','')),0n),13597500n);const balances=await api(`/fulfillment/orders/${so._id}/balances`);assert.equal(units(balances.lines[0].shippedQuantity),10000000n);assert.equal(units(balances.lines[0].invoicedQuantity),10000000n);for(const [i,receipt] of receipts.entries()){const balance=await api(`/warehouse/receipts/${receipt._id}`);for(const key of ['availableQuantity','reservedQuantity','manufacturingReservedQuantity'])assert.equal(units(balance[key] || '0'),0n,key);assert.equal(units(balance.manufacturingConsumedQuantity),units(f.procurement.goods_receipt.lines[i].received_qty));}assert.deepEqual(await api(`/manufacturing/engineering/${engineeringId}/revisions/2`),frozenEngineering);
  manifest.timeline=timeline;manifest.summary={workOrders:workOrders.map(row=>({id:row._id,quantity:row.quantity})),outputSerials:outputs.map(row=>row.serial).sort(),laborEntries:labor.length,materialConsumptions:consumptions.length,shipments:shipments.map(row=>row._id),deliveryConfirmations:deliveries.map(row=>row.confirmationCount),invoiceNet:invoices.map(row=>row.netAmount),invoiceTax:invoices.map(row=>row.taxAmount),invoiceGross:invoices.map(row=>row.total),settlement:'135975.00',runtimeOrderStatus:(await api(`/commercial/orders/${so._id}`)).status,proofBoundary:'Actual local Mongo/HTTP/native Chromium proof; not PostgreSQL, production, statutory tax, verified machine execution or external carrier proof.'};await writeEvidence('canonical-e01-native-manifest.json',manifest);
  check('Original E01 native engineeringB/WO6+4/four original labor actors and windows/ten exact serial outputs/QC/five-source per-unit genealogy/shipments6+4/POD6+4/invoices73500+8085 and49000+5390/settlement135975 conserve actual identities and material');
  return {manifest,accountId,inquiry,quote,so,engineering,workOrders,shipments,deliveries,invoices,payments};
