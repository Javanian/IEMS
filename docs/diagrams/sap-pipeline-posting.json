  "cards": [
    {
      "dot": "cyan",
      "title": "Direct path",
      "items": [
        "sap-post-worker runs post_sap_staging.py in a loop; one UPDATE claims PENDING rows as POSTING",
        "Guards skip a row whose segment is already POSTED or whose ZTIMESHEETID SAP already used",
        "Network errors are retried; SAP business rejections are not"
      ]
    },
    {
      "dot": "violet",
      "title": "Kafka path (SAP_TRANSPORT=kafka)",
      "items": [
        "The relay claims rows as QUEUED and publishes them keyed by order",
        "The poster posts only if the row is still QUEUED with the same payload hash, using the same guards and table writes as post_sap_staging.py",
        "QUEUED rows left too long return to their previous status"
      ]
    },
    {
      "dot": "amber",
      "title": "Admin actions",
      "items": [
        "UI buttons never call SAP directly: the API only queues a request in sap_ops_request",
        "ops_worker.py runs the matching script: stage catch-up, retry failed, post corrections, post a date or operator"
      ]
    }
  ]
