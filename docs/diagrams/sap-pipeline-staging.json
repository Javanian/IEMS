  "cards": [
    {
      "dot": "cyan",
      "title": "Every hour",
      "items": [
        "sap-stage-worker runs stage_machinehours.py --catchup in a loop",
        "Eligible rows need an operator, a valid time span and a productive or unproductive activity",
        "Rows are bundled per day, operator, order, operation, machine and activity; bundles under 60 s are dropped"
      ]
    },
    {
      "dot": "rose",
      "title": "Database triggers",
      "items": [
        "Editing a mch_transaction row that already reached SAP is rejected and logged in sap_source_change_blocked",
        "Editing a row behind an unposted bundle deletes that bundle, so the next run stages the corrected data"
      ]
    },
    {
      "dot": "amber",
      "title": "Normal vs correction",
      "items": [
        "A day with no POSTED bundle stages NORMAL bundles that post automatically",
        "Hours that arrive after a day was posted become correction bundles that an admin sends from the UI"
      ]
    }
  ]
