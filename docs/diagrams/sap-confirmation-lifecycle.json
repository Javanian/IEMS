  "cards": [
    {
      "dot": "cyan",
      "title": "One claim per row",
      "items": [
        "A worker moves a row to POSTING in one UPDATE before calling SAP",
        "Two workers can never post the same row"
      ]
    },
    {
      "dot": "violet",
      "title": "Kafka path",
      "items": [
        "The poster posts only if the row is still QUEUED with the same payload hash",
        "Rows left QUEUED too long go back to their previous status"
      ]
    },
    {
      "dot": "rose",
      "title": "Guards",
      "items": [
        "A segment already POSTED or a ZTIMESHEETID already used in SAP is SKIPPED",
        "Editing source data deletes unposted rows so they are staged again"
      ]
    }
  ]
