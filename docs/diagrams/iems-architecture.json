  "cards": [
    {
      "dot": "cyan",
      "title": "Per plant",
      "items": [
        "Each plant runs its own Compose stack on the factory LAN",
        "Fonts and assets are bundled, so the app works offline"
      ]
    },
    {
      "dot": "violet",
      "title": "Kafka is optional",
      "items": [
        "Dashed paths run only with the kafka profiles",
        "Confirmations are keyed by order, so CPI order locks are respected by partitioning"
      ]
    },
    {
      "dot": "emerald",
      "title": "Safe posting",
      "items": [
        "Rows are claimed before posting and checked against a payload hash",
        "Late or duplicate messages are dropped instead of posted twice"
      ]
    }
  ]
